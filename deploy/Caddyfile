# goes on the vps at /etc/caddy/Caddyfile
#
# caddy rather than nginx because it gets and renews the https certificate on
# its own. no certbot, no cron job, no expiry at 3am

henehoe.app {
	root * /var/www/henehoe
	encode gzip zstd

	# an item's art never changes under a given id, so it can be cached for a
	# year and never revalidated. this is what keeps repeat visits free.
	#
	# `file` is load bearing. the matcher used to be path only, so a 404 got the
	# immutable header too, and a browser that asked for a sheet during the
	# window where the index already listed it but the upload had not landed
	# cached the miss for a year. immutable means it never even rechecks, so
	# that item was dead in that browser until the visitor cleared site data
	@art {
		path /avatar/*
		not path /avatar/index/* /avatar/*/index.json /avatar/meta.json /avatar/delays.json /avatar/face-delays.json
		file
	}
	header @art Cache-Control "public, max-age=31536000, immutable"

	# the index is the opposite. it is rebuilt every time items are added, under
	# the same name, so caching it for a year means a returning visitor never
	# sees a new item again. no-cache still stores it, it just has to revalidate
	# first, and caddy's etag turns the unchanged case into a 304 with no body
	#
	# /avatar/*/index.json is Effect/index.json, which was missed until
	# 2026-08-13 because it sits inside a folder of per-item art rather than
	# beside the other aggregates. it is the list of which items have an effect,
	# 1,664 of them and one longer after every drop, so a year of immutable meant
	# a returning visitor's new capes rendered with no effect on them. written as
	# a wildcard rather than the one filename, so a second folder growing an
	# index is covered the day it does
	@idx path /avatar/index/* /avatar/*/index.json /avatar/meta.json /avatar/delays.json /avatar/face-delays.json
	header @idx Cache-Control "no-cache"

	# the rest of the art, on the same reasoning as the sheets above. map plates
	# and ui sprites keep their names, and next's chunks carry a content hash so
	# a change is a new name. `file` again, so a miss is not cached forever
	@static {
		path /_next/static/* /maps/* /ui/* /cursor/* /font/*
		not path *.json
		file
	}
	header @static Cache-Control "public, max-age=31536000, immutable"

	# the manifests sitting beside that art are the avatar index story again, and
	# were caught by the rule above because they live under the same paths.
	#
	# /maps/index.json is rewritten by every `npm run maps`, and layers.json and
	# particles.json by every re-dump, all under their own names. a year of
	# immutable on those means a returning visitor is pinned to the map list they
	# first loaded: the day a map gains particles, everyone who has ever opened
	# the site keeps the version that says it has none. purging cloudflare does
	# not reach a browser, so there is no fixing it after the fact
	#
	# suffix matched rather than /maps/*.json, because a caddy wildcard in the
	# middle of a path does not cross a slash and the manifests are three deep
	@manifest {
		path *.json
		not path /avatar/*
	}
	header @manifest Cache-Control "no-cache"

	# every page, not just the root.
	#
	# this used to be `path /`, which matches the exact root and nothing else.
	# that was invisible while / was the only route, then /changelog shipped
	# with no cache-control at all and inherited cloudflare's 4 hour default,
	# which is exactly wrong for the one page whose job is to show what changed.
	#
	# stated as "not the things handled above" so a new route is covered the day
	# it exists rather than the day someone notices. it also picks up sitemap,
	# robots and opengraph-image.png, which all keep their names while their
	# contents change, so revalidating is right for them too
	@html {
		not path /avatar/* /_next/static/* /maps/* /ui/* /cursor/* /font/*
	}
	header @html Cache-Control "public, max-age=0, must-revalidate"

	# Sent on everything.
	#
	# The site takes a file the visitor chose, an outfit export from another
	# simulator, and renders names out of it. Nothing is written as html, react
	# escapes it and the captions go through canvas, so there is no known way in.
	# These are the second line for the day that changes
	header {
		# no sniffing a .json into a script
		X-Content-Type-Options nosniff
		# no framing, for the browsers predating frame-ancestors
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		# none of it is used, so none of it is granted
		Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"

		# unsafe-inline twice, and both are load bearing rather than lazy.
		#
		# script: mantine's colour scheme script is inline in the exported html,
		# and a static export has no server to mint a nonce. it could be pinned
		# by hash, and then a mantine update would silently break the page.
		# style: mantine and typestyle both inject <style> at runtime, and the
		# export carries inline style attributes.
		#
		# so script-src is not stopping an injected inline script. what it is
		# stopping is a script, a font, an image or a fetch from anywhere but
		# here and cloudflare, which is what an exfiltration needs
		#
		# the two cloudflare hosts are web analytics, which is turned on in their
		# dashboard rather than in this repo: they inject beacon.min.js into the
		# html on the way through, so it appears in no build output here and was
		# only found by the console refusing it. static. serves the script,
		# the bare host takes the beacon it posts back
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' https://cloudflareinsights.com; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'"
	}

	# next writes /foo.html but links to /foo, so try the file with .html on
	try_files {path} {path}.html {path}/index.html

	file_server
}

# www goes to the bare domain, so the two do not compete for cache entries
www.henehoe.app {
	redir https://henehoe.app{uri} permanent
}
